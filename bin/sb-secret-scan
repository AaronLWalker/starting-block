#!/bin/sh
# Run scripts/secret_scan.py with whichever Python 3.9+ this machine has: python3, python, or the Windows py launcher.
# (On Windows, python3 is often the Microsoft Store stub, which the version check below skips.)
here=$(cd "$(dirname "$0")" && pwd)
for py in python3 python; do
    if "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
        exec "$py" "$here/../scripts/secret_scan.py" "$@"
    fi
done
if command -v py >/dev/null 2>&1; then
    exec py -3 "$here/../scripts/secret_scan.py" "$@"
fi
echo "starting-block: needs Python 3.9 or later on PATH (python3, python or py)" >&2
exit 127
